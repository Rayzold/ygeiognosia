# Cloudflare Pages response headers.
# HSTS: HTTPS only for a year (no includeSubDomains until the domain is fully on Cloudflare).
# CSP: only our own files. 'unsafe-inline' is required by the static Next.js export (inline bootstrap
# scripts) and inline styles. Cloudflare Web Analytics allowed. frame-src: the Google map on /contact (as on
# Wix) and the YouTube player in blog posts (youtube-nocookie.com, loaded only after a click).
# connect-src/form-action: the /contact form posts to Jotform (eu-submit.jotform.com).
# Phase 5γ the Viva checkout redirect: extend only what it needs.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self'; connect-src 'self' https://eu-submit.jotform.com https://cloudflareinsights.com; frame-src 'self' https://www.google.com https://maps.google.com https://www.youtube-nocookie.com; form-action 'self' https://eu-submit.jotform.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Preview hosts (*.pages.dev, branch previews) must never be indexed: only www.ygeiognosia.com is canonical.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Build output with hashed file names never changes: cache for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images, video and files keep their names when replaced, so cache for a week only.
/images/*
  Cache-Control: public, max-age=604800
/video/*
  Cache-Control: public, max-age=604800
/files/*
  Cache-Control: public, max-age=604800
