       "runs": [
        {
         "t": "οικολογικά απορρυπαντικά, βιολογικά καλλυντικά, χαρτικά, αιθέραια έλαια, είδη δώρων,",
         "f": "2a288b1e",
         "s": 16,
         "c": "rgb(255, 255, 255)"
        }
