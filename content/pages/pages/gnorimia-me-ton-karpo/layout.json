        {
          "id": "comp-kh6hc5ou",
          "x": 79,
          "y": 97,
          "w": 418,
          "h": 474,
          "kind": "text",
          "blocks": [
            {
              "tag": "p",
              "align": "left",
              "fs": 15,
              "lh": null,
              "runs": [
                {
                  "t": "Ο καρπός της άγριας ελιάς αποτελεί ένα από τα σπανιότερα και αρχαιότερα δώρα της φύσης, ένα έλαιο με πολύ υψηλό αριθμών φαινολών και με μια ασυγκράτητα άγρια γεύση που θέλει το χρόνο της για να εξημερώσει την αντίληψη ενός έμπειρου γευσιγνώστη.  ",
                  "f": "84b1395d",
                  "s": 15,
                  "c": "rgb(255, 255, 255)"
                }
              ]
            },
            {
              "tag": "p",
              "align": "left",
              "fs": 15,
              "lh": null,
              "runs": [
                {
                  "t": " ",
                  "f": "84b1395d",
                  "s": 15,
                  "c": "rgb(255, 255, 255)"
                }
              ]
            },
            {
              "tag": "p",
              "align": "left",
              "fs": 15,
              "lh": null,
              "runs": [
                {
                  "t": "Με μια αυστηρά πικρή επίγευση, πλούσια ακόμα και μεθύστερα σε δυναμική, αναδίδει τα οφέλη του άμεσα σε κάθε οργανισμό. Μετά κι από έρευνες των τελευταίων ετών, το αγριέλαιο πλέον μπορεί να καταταχτεί σε περίοπτη θέση ανάμεσα στις υπερτροφές παγκοσμίως, Οι πολυφαινόλες ως γνωστόν είναι το απόλυτο αντί οξειδωτικό της φύσης, κάτι που αποτελεί άλλωστε και τη βάση για τον αναγνωρισμένο από την Ε.Ε. \"Ισχυρισμό Υγείας\" που το συνοδεύει. Κι όπως όλα τα αντιοξειδωτικά, πόσο μάλλον κι αυτό, προστατεύει πρωταρχικά από: υψηλή χοληστερίνη, καρδιακές παθήσεις, και καρκίνο. ",
                  "f": "84b1395d",
                  "s": 15,
                  "c": "rgb(255, 255, 255)"
                }
              ]
            },
            {
              "tag": "p",
              "align": "left",
              "fs": 15,
              "lh": null,
              "runs": [
                {
                  "t": " ",
                  "f": "84b1395d",
                  "s": 15,
                  "c": "rgb(255, 255, 255)"
                }
              ]
            }
          ]
        },
