              "lh": null,
              "runs": [
                {
                  "t": "Ήξερε και ότι στο εξής θα έμενε μόνος.",
                  "f": "84b1395d",
                  "s": 15,
                  "c": "rgb(255, 255, 255)"
                }
              ]
            },
            {
              "tag": "p",
